# Copia este archivo a .env (está en .gitignore). Solo para desarrollo.
PORT=3000
DATABASE_URL=postgresql://foilhub:foilhub_dev@localhost:5432/foilhub?schema=public
# En Swarm se usa JWT_SECRET_FILE=/run/secrets/jwt_secret en lugar de JWT_SECRET.
JWT_SECRET=cambia-esto-en-desarrollo
JWT_EXPIRES_IN=1h
# file | digimoncardio
CARD_CATALOG_SOURCE=file
