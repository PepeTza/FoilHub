{
  "name": "backend",
  "version": "0.0.1",
  "description": "API de FoilHub (NestJS + Prisma 7)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/infrastructure/main.js",
    "prelint": "prisma generate",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:cov:domain": "vitest run --coverage --coverage.include=\"src/domain/**\" --coverage.exclude=\"**/*.spec.ts\" --coverage.thresholds.lines=90",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "prisma generate",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "cards:import": "nest start --entryFile infrastructure/cli/import-cards",
    "cards:import:prod": "node dist/infrastructure/cli/import-cards.js",
    "seed:demo": "nest start --entryFile infrastructure/cli/seed-demo",
    "seed:demo:prod": "node dist/infrastructure/cli/seed-demo.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
